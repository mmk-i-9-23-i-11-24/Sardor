@startuml
left to right direction

actor "Ученик" as Student #red;line:orange

rectangle "Процесс обучения" {
  :Пользователь: --> (Вводит свои данные) #yellow
  :Пользователь: --> (Работает на платформе) #lightgreen
  :Пользователь: --> (Написать свои предпочтения) #lightgrey
  :Пользователь: --> (Выбрать платформу) #lightsalmon
  :Пользователь: --> (Участвовать в онлайн-обучении) #steelblue

  (Работает на платформе) <.. (Получить новые знания по предметам, которые нравятся) :extend
  (Получить новые знания по предметам, которые нравятся) #lightgreen

  (Работает на платформе) <.. (Подготовиться к экзаменам и контрольным) :extend
  (Подготовиться к экзаменам и контрольным) #lightgreen

  (Работает на платформе) <.. (Развивать навыки самостоятельного обучения) :extend
  (Развивать навыки самостоятельного обучения) #lightgreen

  (Работает на платформе) <.. (Общаться с другими детьми и найти друзей) :extend
  (Общаться с другими детьми и найти друзей) #lightgreen

  (Написать свои предпочтения) <.. (Написать предпочитаемое время) :extend
  (Написать предпочитаемое время) #lightgrey

  (Написать свои предпочтения) <.. (Написать предпочитаемый формат) :extend
  (Написать предпочитаемый формат) #lightgrey

  (Выбрать платформу) <|-- (Khan Academy) #lightsalmon
  (Выбрать платформу) <|-- (Coursera для детей) #lightsalmon
  (Выбрать платформу) <|-- (Duolingo) #lightsalmon
  (Выбрать платформу) <|-- (Minecraft Education) #lightsalmon

  (Участвовать в онлайн-обучении) ..> (Участвовать в интерактивных элементах) :include
  (Участвовать в интерактивных элементах) #lightblue

  (Участвовать в онлайн-обучении) <.. (Общаться с другими учениками) :extend
  (Общаться с другими учениками) #lightblue
}

Student --> (Вводит свои данные)
Student --> (Участвовать в онлайн-обучении)

@enduml
